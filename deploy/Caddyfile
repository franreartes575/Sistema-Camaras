# Proxy TLS delante del sistema (recomendado: certificados automáticos).
#
#   caddy run --config deploy/Caddyfile
#
# Reemplazá camaras.ejemplo.gob.ar por el nombre real. Para una red interna
# sin salida a internet, usá `tls internal` (CA propia de Caddy) o tus
# certificados: `tls /ruta/cert.pem /ruta/clave.pem`.
#
# Por qué es obligatorio:
#   - Las cookies de sesión son Secure: fuera de localhost, sin HTTPS el
#     navegador no las guarda y nadie puede ingresar.
#   - Caddy reescribe X-Forwarded-For con la IP real del cliente (no confía en
#     la que manda el cliente): es la IP que queda en la auditoría y la que
#     cuenta para el límite de intentos.
#
# El backend y el frontend escuchan sólo en 127.0.0.1: desde la red se llega
# únicamente por acá.
#
# Límite de pedidos: Caddy no lo trae sin un plugin (caddy-ratelimit). Los
# límites por IP los aplica el backend (por endpoint y en el login); si el
# servicio queda expuesto a internet y no a una red interna, usá nginx.conf,
# que además los aplica antes de llegar a Python.

{
	servers {
		# Un cliente que manda los encabezados o el cuerpo de a gotas
		# (slowloris) no retiene conexiones indefinidamente.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

camaras.ejemplo.gob.ar {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	# La API va directo al backend (sin pasar por Next). handle_path quita el
	# prefijo /api y conserva la barra final de las rutas de FastAPI.
	handle_path /api/* {
		request_body {
			max_size 33MB
		}
		reverse_proxy 127.0.0.1:8000 {
			# /optimize/ puede tardar minutos con muchas sedes: que el
			# proxy no lo corte antes que el backend.
			transport http {
				response_header_timeout 300s
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
